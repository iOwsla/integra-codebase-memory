{
  "name": "integra-codebase-memory",
  "version": "0.1.0-alpha.29",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun apps/cli/src/index.ts",
    "build": "bun build apps/cli/src/index.ts --target=bun --packages=external --outdir=dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "db:migrate": "bun scripts/migrate.ts",
    "db:status": "bun scripts/migrate.ts --status",
    "benchmark": "bun scripts/benchmark.ts",
    "verify:parser": "bun scripts/verify-parser.ts",
    "profile:parser": "bun scripts/profile-parser.ts",
    "simulate:project": "bun scripts/simulate-project.ts",
    "connect:codex": "bun scripts/connect-codex.ts",
    "verify:mcp": "bun scripts/verify-mcp.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "ignore": "^7.0.9",
    "pg": "^8.23.0",
    "picomatch": "^4.0.7",
    "typescript": "6.0.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/bun": "^1.4.2",
    "@types/node": "22.20.2",
    "@types/pg": "^8.23.1",
    "@types/picomatch": "^4.0.3",
    "vitest": "^5.0.0"
  },
  "description": "Local code intelligence and project memory for MCP coding agents, with TypeScript, JavaScript and Prisma analysis.",
  "license": "MIT",
  "homepage": "https://github.com/iOwsla/integra-codebase-memory#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/iOwsla/integra-codebase-memory.git"
  },
  "bugs": {
    "url": "https://github.com/iOwsla/integra-codebase-memory/issues"
  },
  "keywords": [
    "mcp",
    "code-intelligence",
    "codebase-memory",
    "typescript",
    "javascript",
    "prisma",
    "codex",
    "claude-code"
  ]
}
